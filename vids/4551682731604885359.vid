PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid5.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
s2 = SPLIT(input=f1, at=6);
l3 = LOAD(file="media/vid1.mp4");
f4 = FPS_CHANGE(input=l3, new_fps=PROJECT.fps);
b5 = BLUR(input=f4, sigma=6.62);
tn6 = TRANSITION(a=s2.first, b=b5, kind=CROSSFADE, seconds=3);
s7 = SPLIT(input=tn6, at=7);
t8 = TRIM(input=s7.second, start=9, end=10);
l9 = LOAD(file="media/vid2.mp4");
f10 = FPS_CHANGE(input=l9, new_fps=PROJECT.fps);
cl11 = COLOR_CHANGE(input=f10, strength=0.90);
s12 = SPLIT(input=cl11, at=6);
cl13 = COLOR_CHANGE(input=s12.second, strength=-0.36);
c14 = CROP(input=cl13, left_x=1578, left_y=284, right_x=1767, right_y=359);
l15 = LOAD(file="media/vid5.mp4");
f16 = FPS_CHANGE(input=l15, new_fps=PROJECT.fps);
t17 = TRIM(input=f16, start=2, end=4);
cl18 = COLOR_CHANGE(input=t17, strength=-0.69);
s19 = SPLIT(input=cl18, at=3);
l20 = LOAD(file="media/vid5.mp4");
f21 = FPS_CHANGE(input=l20, new_fps=PROJECT.fps);
l22 = LOAD(file="media/vid5.mp4");
f23 = FPS_CHANGE(input=l22, new_fps=PROJECT.fps);
cc24 = CONCAT(input1=f21, input2=f23);
l25 = LOAD(file="media/vid4.mp4");
f26 = FPS_CHANGE(input=l25, new_fps=PROJECT.fps);
tr27 = TRANSFORM(input=f26, trans_x=127, trans_y=305, rot_x=1826, rot_y=908, deg_of_rot=169.30, scale_x=944, scale_y=623, scale_factor=0.28);
cc28 = CONCAT(input1=cc24, input2=tr27);
s29 = SPLIT(input=cc28, at=2);
l30 = LOAD(file="media/vid6.mp4");
f31 = FPS_CHANGE(input=l30, new_fps=PROJECT.fps);
l32 = LOAD(file="media/vid2.mp4");
f33 = FPS_CHANGE(input=l32, new_fps=PROJECT.fps);
p34 = PANCAKE(bottom=f31, top=f33);
s35 = SPLIT(input=p34, at=3);
b36 = BLUR(input=s35.first, sigma=8.07);
l37 = LOAD(file="media/vid1.mp4");
f38 = FPS_CHANGE(input=l37, new_fps=PROJECT.fps);
b39 = BLUR(input=f38, sigma=9.39);
l40 = LOAD(file="media/vid3.mp4");
f41 = FPS_CHANGE(input=l40, new_fps=PROJECT.fps);
b42 = BLUR(input=f41, sigma=5.66);
p43 = PANCAKE(bottom=b39, top=b42);
b44 = BLUR(input=p43, sigma=0.76);
cc45 = CONCAT(input1=s19.first, input2=s29.first, input3=b36, input4=b44);
cc46 = CONCAT(input1=t8, input2=c14, input3=cc45);
t47 = TRIM(input=cc46, start=4, end=9);

OUTPUT(file="4551682731604885359.mp4", input=t47);
