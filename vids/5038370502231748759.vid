PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid1.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
l2 = LOAD(file="media/vid2.mp4");
f3 = FPS_CHANGE(input=l2, new_fps=PROJECT.fps);
p4 = PANCAKE(bottom=f1, top=f3);
sat5 = SATURATION_CHANGE(input=p4, factor=1.31);
b6 = BLUR(input=sat5, sigma=9.65);
s7 = SPLIT(input=b6, at=6);
cl8 = COLOR_CHANGE(input=s7.second, strength=0.46);
c9 = CROP(input=cl8, left_x=798, left_y=529, right_x=931, right_y=980);

OUTPUT(file="5038370502231748759.mp4", input=c9);
