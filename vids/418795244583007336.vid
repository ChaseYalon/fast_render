PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid6.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
l2 = LOAD(file="media/vid6.mp4");
f3 = FPS_CHANGE(input=l2, new_fps=PROJECT.fps);
cc4 = CONCAT(input1=f1, input2=f3);
tr5 = TRANSFORM(input=cc4, trans_x=-312, trans_y=-389, rot_x=316, rot_y=1030, deg_of_rot=133.65, scale_x=106, scale_y=797, scale_factor=1.27);
l6 = LOAD(file="media/vid4.mp4");
f7 = FPS_CHANGE(input=l6, new_fps=PROJECT.fps);
sat8 = SATURATION_CHANGE(input=f7, factor=0.85);
sat9 = SATURATION_CHANGE(input=sat8, factor=0.84);
l10 = LOAD(file="media/vid2.mp4");
f11 = FPS_CHANGE(input=l10, new_fps=PROJECT.fps);
tr12 = TRANSFORM(input=f11, trans_x=-307, trans_y=370, rot_x=584, rot_y=1015, deg_of_rot=71.01, scale_x=1220, scale_y=535, scale_factor=2.85);
b13 = BLUR(input=tr12, sigma=3.79);
cc14 = CONCAT(input1=tr5, input2=sat9, input3=b13);
s15 = SPLIT(input=cc14, at=4);
l16 = LOAD(file="media/vid2.mp4");
f17 = FPS_CHANGE(input=l16, new_fps=PROJECT.fps);
cl18 = COLOR_CHANGE(input=f17, strength=-0.51);
c19 = CROP(input=cl18, left_x=539, left_y=814, right_x=1455, right_y=953);
tr20 = TRANSFORM(input=c19, trans_x=-7, trans_y=462, rot_x=1572, rot_y=201, deg_of_rot=-155.58, scale_x=1852, scale_y=676, scale_factor=1.44);
cl21 = COLOR_CHANGE(input=tr20, strength=0.74);
l22 = LOAD(file="media/vid5.mp4");
f23 = FPS_CHANGE(input=l22, new_fps=PROJECT.fps);
l24 = LOAD(file="media/vid2.mp4");
f25 = FPS_CHANGE(input=l24, new_fps=PROJECT.fps);
tn26 = TRANSITION(a=f23, b=f25, kind=DIP_TO_BLACK, seconds=2);
tr27 = TRANSFORM(input=tn26, trans_x=-205, trans_y=-353, rot_x=1109, rot_y=168, deg_of_rot=148.20, scale_x=1809, scale_y=229, scale_factor=0.96);
cl28 = COLOR_CHANGE(input=tr27, strength=-0.75);
sat29 = SATURATION_CHANGE(input=cl28, factor=2.96);
cc30 = CONCAT(input1=s15.first, input2=cl21, input3=sat29);
t31 = TRIM(input=cc30, start=2, end=9);

OUTPUT(file="418795244583007336.mp4", input=t31);
