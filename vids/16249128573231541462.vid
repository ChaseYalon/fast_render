PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid5.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
t2 = TRIM(input=f1, start=9, end=10);
l3 = LOAD(file="media/vid5.mp4");
f4 = FPS_CHANGE(input=l3, new_fps=PROJECT.fps);
l5 = LOAD(file="media/vid6.mp4");
f6 = FPS_CHANGE(input=l5, new_fps=PROJECT.fps);
tn7 = TRANSITION(a=f4, b=f6, kind=CROSSFADE, seconds=3);
cc8 = CONCAT(input1=t2, input2=tn7);
tr9 = TRANSFORM(input=cc8, trans_x=-219, trans_y=214, rot_x=317, rot_y=136, deg_of_rot=-11.90, scale_x=1686, scale_y=287, scale_factor=2.67);
c10 = CROP(input=tr9, left_x=173, left_y=361, right_x=1502, right_y=876);
s11 = SPLIT(input=c10, at=1);
l12 = LOAD(file="media/vid1.mp4");
f13 = FPS_CHANGE(input=l12, new_fps=PROJECT.fps);
s14 = SPLIT(input=f13, at=3);
cl15 = COLOR_CHANGE(input=s14.first, strength=-0.96);
c16 = CROP(input=cl15, left_x=1839, left_y=820, right_x=1903, right_y=1080);
cl17 = COLOR_CHANGE(input=c16, strength=0.73);
cl18 = COLOR_CHANGE(input=cl17, strength=0.64);
cc19 = CONCAT(input1=s11.first, input2=cl18);

OUTPUT(file="16249128573231541462.mp4", input=cc19);
