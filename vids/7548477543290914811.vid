PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid1.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
s2 = SPLIT(input=f1, at=9);
b3 = BLUR(input=s2.first, sigma=3.68);
b4 = BLUR(input=b3, sigma=8.81);
t5 = TRIM(input=b4, start=9, end=10);
c6 = CROP(input=t5, left_x=250, left_y=165, right_x=1359, right_y=811);
s7 = SPLIT(input=c6, at=2);

OUTPUT(file="7548477543290914811.mp4", input=s7.second);
