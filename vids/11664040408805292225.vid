PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid4.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
c2 = CROP(input=f1, left_x=350, left_y=301, right_x=739, right_y=582);
t3 = TRIM(input=c2, start=5, end=8);
s4 = SPLIT(input=t3, at=9);
l5 = LOAD(file="media/vid4.mp4");
f6 = FPS_CHANGE(input=l5, new_fps=PROJECT.fps);
l7 = LOAD(file="media/vid6.mp4");
f8 = FPS_CHANGE(input=l7, new_fps=PROJECT.fps);
tn9 = TRANSITION(a=f6, b=f8, kind=CROSSFADE, seconds=1);
s10 = SPLIT(input=tn9, at=6);
l11 = LOAD(file="media/vid4.mp4");
f12 = FPS_CHANGE(input=l11, new_fps=PROJECT.fps);
cl13 = COLOR_CHANGE(input=f12, strength=0.44);
s14 = SPLIT(input=cl13, at=3);
tn15 = TRANSITION(a=s10.first, b=s14.second, kind=WIPE_LEFT_TO_RIGHT, seconds=2);
p16 = PANCAKE(bottom=s4.first, top=tn15);
sat17 = SATURATION_CHANGE(input=p16, factor=2.58);
l18 = LOAD(file="media/vid5.mp4");
f19 = FPS_CHANGE(input=l18, new_fps=PROJECT.fps);
cl20 = COLOR_CHANGE(input=f19, strength=-0.62);
l21 = LOAD(file="media/vid1.mp4");
f22 = FPS_CHANGE(input=l21, new_fps=PROJECT.fps);
l23 = LOAD(file="media/vid4.mp4");
f24 = FPS_CHANGE(input=l23, new_fps=PROJECT.fps);
p25 = PANCAKE(bottom=f22, top=f24);
cc26 = CONCAT(input1=cl20, input2=p25);
tr27 = TRANSFORM(input=cc26, trans_x=410, trans_y=-30, rot_x=248, rot_y=386, deg_of_rot=-65.33, scale_x=622, scale_y=383, scale_factor=0.61);
l28 = LOAD(file="media/vid2.mp4");
f29 = FPS_CHANGE(input=l28, new_fps=PROJECT.fps);
t30 = TRIM(input=f29, start=3, end=10);
b31 = BLUR(input=t30, sigma=5.32);
s32 = SPLIT(input=b31, at=7);
tn33 = TRANSITION(a=tr27, b=s32.second, kind=DIP_TO_BLACK, seconds=1);
sat34 = SATURATION_CHANGE(input=tn33, factor=2.41);
l35 = LOAD(file="media/vid3.mp4");
f36 = FPS_CHANGE(input=l35, new_fps=PROJECT.fps);
cl37 = COLOR_CHANGE(input=f36, strength=0.21);
c38 = CROP(input=cl37, left_x=1411, left_y=534, right_x=1515, right_y=645);
t39 = TRIM(input=c38, start=2, end=9);
l40 = LOAD(file="media/vid1.mp4");
f41 = FPS_CHANGE(input=l40, new_fps=PROJECT.fps);
s42 = SPLIT(input=f41, at=2);
l43 = LOAD(file="media/vid5.mp4");
f44 = FPS_CHANGE(input=l43, new_fps=PROJECT.fps);
l45 = LOAD(file="media/vid2.mp4");
f46 = FPS_CHANGE(input=l45, new_fps=PROJECT.fps);
tn47 = TRANSITION(a=f44, b=f46, kind=DIP_TO_BLACK, seconds=3);
p48 = PANCAKE(bottom=s42.second, top=tn47);
l49 = LOAD(file="media/vid1.mp4");
f50 = FPS_CHANGE(input=l49, new_fps=PROJECT.fps);
l51 = LOAD(file="media/vid4.mp4");
f52 = FPS_CHANGE(input=l51, new_fps=PROJECT.fps);
p53 = PANCAKE(bottom=f50, top=f52);
l54 = LOAD(file="media/vid1.mp4");
f55 = FPS_CHANGE(input=l54, new_fps=PROJECT.fps);
tr56 = TRANSFORM(input=f55, trans_x=-304, trans_y=407, rot_x=1257, rot_y=787, deg_of_rot=-171.75, scale_x=18, scale_y=446, scale_factor=2.16);
l57 = LOAD(file="media/vid4.mp4");
f58 = FPS_CHANGE(input=l57, new_fps=PROJECT.fps);
sat59 = SATURATION_CHANGE(input=f58, factor=2.56);
cc60 = CONCAT(input1=p53, input2=tr56, input3=sat59);
tn61 = TRANSITION(a=p48, b=cc60, kind=WIPE_LEFT_TO_RIGHT, seconds=2);
tn62 = TRANSITION(a=t39, b=tn61, kind=DIP_TO_BLACK, seconds=2);
tr63 = TRANSFORM(input=tn62, trans_x=-318, trans_y=241, rot_x=1858, rot_y=29, deg_of_rot=-95.38, scale_x=799, scale_y=164, scale_factor=2.89);
l64 = LOAD(file="media/vid2.mp4");
f65 = FPS_CHANGE(input=l64, new_fps=PROJECT.fps);
b66 = BLUR(input=f65, sigma=1.58);
s67 = SPLIT(input=b66, at=4);
s68 = SPLIT(input=s67.second, at=9);
cl69 = COLOR_CHANGE(input=s68.second, strength=-0.11);
c70 = CROP(input=cl69, left_x=462, left_y=146, right_x=897, right_y=772);
cc71 = CONCAT(input1=sat17, input2=sat34, input3=tr63, input4=c70);

OUTPUT(file="11664040408805292225.mp4", input=cc71);
