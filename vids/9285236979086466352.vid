PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid5.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
cl2 = COLOR_CHANGE(input=f1, strength=-0.42);
c3 = CROP(input=cl2, left_x=601, left_y=1047, right_x=698, right_y=1070);
b4 = BLUR(input=c3, sigma=3.03);
l5 = LOAD(file="media/vid2.mp4");
f6 = FPS_CHANGE(input=l5, new_fps=PROJECT.fps);
l7 = LOAD(file="media/vid4.mp4");
f8 = FPS_CHANGE(input=l7, new_fps=PROJECT.fps);
tn9 = TRANSITION(a=f6, b=f8, kind=WIPE_RIGHT_TO_LEFT, seconds=1);
cl10 = COLOR_CHANGE(input=tn9, strength=-0.29);
c11 = CROP(input=cl10, left_x=1448, left_y=83, right_x=1471, right_y=282);
cc12 = CONCAT(input1=b4, input2=c11);
t13 = TRIM(input=cc12, start=5, end=7);
cl14 = COLOR_CHANGE(input=t13, strength=0.38);

OUTPUT(file="9285236979086466352.mp4", input=cl14);
