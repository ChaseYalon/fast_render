PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid6.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
tr2 = TRANSFORM(input=f1, trans_x=-71, trans_y=441, rot_x=502, rot_y=473, deg_of_rot=95.55, scale_x=1757, scale_y=558, scale_factor=1.54);
t3 = TRIM(input=tr2, start=0, end=1);
l4 = LOAD(file="media/vid5.mp4");
f5 = FPS_CHANGE(input=l4, new_fps=PROJECT.fps);
s6 = SPLIT(input=f5, at=9);
s7 = SPLIT(input=s6.first, at=8);
p8 = PANCAKE(bottom=t3, top=s7.first);
c9 = CROP(input=p8, left_x=1712, left_y=115, right_x=1752, right_y=745);
t10 = TRIM(input=c9, start=3, end=5);
l11 = LOAD(file="media/vid4.mp4");
f12 = FPS_CHANGE(input=l11, new_fps=PROJECT.fps);
b13 = BLUR(input=f12, sigma=0.83);
l14 = LOAD(file="media/vid1.mp4");
f15 = FPS_CHANGE(input=l14, new_fps=PROJECT.fps);
l16 = LOAD(file="media/vid6.mp4");
f17 = FPS_CHANGE(input=l16, new_fps=PROJECT.fps);
p18 = PANCAKE(bottom=f15, top=f17);
tn19 = TRANSITION(a=b13, b=p18, kind=WIPE_RIGHT_TO_LEFT, seconds=2);
sat20 = SATURATION_CHANGE(input=tn19, factor=1.06);
b21 = BLUR(input=sat20, sigma=7.35);
t22 = TRIM(input=b21, start=0, end=4);
tn23 = TRANSITION(a=t10, b=t22, kind=DIP_TO_BLACK, seconds=2);

OUTPUT(file="9827410500490114151.mp4", input=tn23);
