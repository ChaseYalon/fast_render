PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid1.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
b2 = BLUR(input=f1, sigma=4.49);
l3 = LOAD(file="media/vid5.mp4");
f4 = FPS_CHANGE(input=l3, new_fps=PROJECT.fps);
l5 = LOAD(file="media/vid1.mp4");
f6 = FPS_CHANGE(input=l5, new_fps=PROJECT.fps);
p7 = PANCAKE(bottom=f4, top=f6);
p8 = PANCAKE(bottom=b2, top=p7);
l9 = LOAD(file="media/vid2.mp4");
f10 = FPS_CHANGE(input=l9, new_fps=PROJECT.fps);
c11 = CROP(input=f10, left_x=940, left_y=65, right_x=1117, right_y=463);
t12 = TRIM(input=c11, start=14, end=15);
cc13 = CONCAT(input1=p8, input2=t12);
cl14 = COLOR_CHANGE(input=cc13, strength=0.45);
tr15 = TRANSFORM(input=cl14, trans_x=-31, trans_y=480, rot_x=620, rot_y=810, deg_of_rot=141.58, scale_x=722, scale_y=553, scale_factor=0.13);
s16 = SPLIT(input=tr15, at=52);

OUTPUT(file="3943956600034115606.mp4", input=s16.first);
