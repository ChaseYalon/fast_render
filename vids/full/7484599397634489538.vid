PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid6.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
l2 = LOAD(file="media/vid2.mp4");
f3 = FPS_CHANGE(input=l2, new_fps=PROJECT.fps);
l4 = LOAD(file="media/vid3.mp4");
f5 = FPS_CHANGE(input=l4, new_fps=PROJECT.fps);
cc6 = CONCAT(input1=f1, input2=f3, input3=f5);
b7 = BLUR(input=cc6, sigma=1.46);
sat8 = SATURATION_CHANGE(input=b7, factor=1.56);
l9 = LOAD(file="media/vid5.mp4");
f10 = FPS_CHANGE(input=l9, new_fps=PROJECT.fps);
t11 = TRIM(input=f10, start=2, end=6);
sat12 = SATURATION_CHANGE(input=t11, factor=1.95);
t13 = TRIM(input=sat12, start=3, end=4);
p14 = PANCAKE(bottom=sat8, top=t13);
c15 = CROP(input=p14, left_x=624, left_y=781, right_x=752, right_y=948);
cl16 = COLOR_CHANGE(input=c15, strength=-0.60);

OUTPUT(file="7484599397634489538.mp4", input=cl16);
