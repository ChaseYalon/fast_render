PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid2.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
tr2 = TRANSFORM(input=f1, trans_x=495, trans_y=246, rot_x=1182, rot_y=486, deg_of_rot=-165.62, scale_x=586, scale_y=229, scale_factor=0.49);
l3 = LOAD(file="media/vid2.mp4");
f4 = FPS_CHANGE(input=l3, new_fps=PROJECT.fps);
l5 = LOAD(file="media/vid5.mp4");
f6 = FPS_CHANGE(input=l5, new_fps=PROJECT.fps);
tn7 = TRANSITION(a=f4, b=f6, kind=WIPE_LEFT_TO_RIGHT, seconds=5);
cc8 = CONCAT(input1=tr2, input2=tn7);
l9 = LOAD(file="media/vid6.mp4");
f10 = FPS_CHANGE(input=l9, new_fps=PROJECT.fps);
t11 = TRIM(input=f10, start=6, end=7);
l12 = LOAD(file="media/vid5.mp4");
f13 = FPS_CHANGE(input=l12, new_fps=PROJECT.fps);
tr14 = TRANSFORM(input=f13, trans_x=468, trans_y=-369, rot_x=712, rot_y=452, deg_of_rot=-6.82, scale_x=1109, scale_y=620, scale_factor=0.63);
p15 = PANCAKE(bottom=t11, top=tr14);
cc16 = CONCAT(input1=cc8, input2=p15);
cl17 = COLOR_CHANGE(input=cc16, strength=0.45);
l18 = LOAD(file="media/vid4.mp4");
f19 = FPS_CHANGE(input=l18, new_fps=PROJECT.fps);
cl20 = COLOR_CHANGE(input=f19, strength=0.42);
cl21 = COLOR_CHANGE(input=cl20, strength=-0.14);
l22 = LOAD(file="media/vid1.mp4");
f23 = FPS_CHANGE(input=l22, new_fps=PROJECT.fps);
c24 = CROP(input=f23, left_x=1769, left_y=53, right_x=1820, right_y=790);
l25 = LOAD(file="media/vid5.mp4");
f26 = FPS_CHANGE(input=l25, new_fps=PROJECT.fps);
b27 = BLUR(input=f26, sigma=2.81);
tn28 = TRANSITION(a=c24, b=b27, kind=CROSSFADE, seconds=5);
tn29 = TRANSITION(a=cl21, b=tn28, kind=DIP_TO_BLACK, seconds=2);
l30 = LOAD(file="media/vid2.mp4");
f31 = FPS_CHANGE(input=l30, new_fps=PROJECT.fps);
t32 = TRIM(input=f31, start=8, end=11);
l33 = LOAD(file="media/vid3.mp4");
f34 = FPS_CHANGE(input=l33, new_fps=PROJECT.fps);
t35 = TRIM(input=f34, start=15, end=17);
l36 = LOAD(file="media/vid4.mp4");
f37 = FPS_CHANGE(input=l36, new_fps=PROJECT.fps);
l38 = LOAD(file="media/vid6.mp4");
f39 = FPS_CHANGE(input=l38, new_fps=PROJECT.fps);
cc40 = CONCAT(input1=f37, input2=f39);
cc41 = CONCAT(input1=t32, input2=t35, input3=cc40);
l42 = LOAD(file="media/vid3.mp4");
f43 = FPS_CHANGE(input=l42, new_fps=PROJECT.fps);
l44 = LOAD(file="media/vid1.mp4");
f45 = FPS_CHANGE(input=l44, new_fps=PROJECT.fps);
tn46 = TRANSITION(a=f43, b=f45, kind=DIP_TO_BLACK, seconds=8);
c47 = CROP(input=tn46, left_x=1089, left_y=280, right_x=1575, right_y=577);
p48 = PANCAKE(bottom=cc41, top=c47);
tn49 = TRANSITION(a=tn29, b=p48, kind=WIPE_RIGHT_TO_LEFT, seconds=19);
tn50 = TRANSITION(a=cl17, b=tn49, kind=WIPE_RIGHT_TO_LEFT, seconds=24);
sat51 = SATURATION_CHANGE(input=tn50, factor=2.33);

OUTPUT(file="5866623123169566427.mp4", input=sat51);
