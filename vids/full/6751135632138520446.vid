PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid3.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
tr2 = TRANSFORM(input=f1, trans_x=457, trans_y=-157, rot_x=1043, rot_y=657, deg_of_rot=-100.30, scale_x=901, scale_y=814, scale_factor=0.45);
t3 = TRIM(input=tr2, start=1, end=9);
tr4 = TRANSFORM(input=t3, trans_x=-292, trans_y=70, rot_x=28, rot_y=601, deg_of_rot=-7.46, scale_x=804, scale_y=97, scale_factor=2.45);
l5 = LOAD(file="media/vid5.mp4");
f6 = FPS_CHANGE(input=l5, new_fps=PROJECT.fps);
cl7 = COLOR_CHANGE(input=f6, strength=0.81);
b8 = BLUR(input=cl7, sigma=6.26);
tr9 = TRANSFORM(input=b8, trans_x=-275, trans_y=-292, rot_x=1405, rot_y=391, deg_of_rot=60.34, scale_x=1447, scale_y=981, scale_factor=2.59);
p10 = PANCAKE(bottom=tr4, top=tr9);
l11 = LOAD(file="media/vid3.mp4");
f12 = FPS_CHANGE(input=l11, new_fps=PROJECT.fps);
b13 = BLUR(input=f12, sigma=0.86);
l14 = LOAD(file="media/vid6.mp4");
f15 = FPS_CHANGE(input=l14, new_fps=PROJECT.fps);
c16 = CROP(input=f15, left_x=1636, left_y=477, right_x=1825, right_y=693);
l17 = LOAD(file="media/vid2.mp4");
f18 = FPS_CHANGE(input=l17, new_fps=PROJECT.fps);
b19 = BLUR(input=f18, sigma=5.80);
cc20 = CONCAT(input1=b13, input2=c16, input3=b19);
l21 = LOAD(file="media/vid1.mp4");
f22 = FPS_CHANGE(input=l21, new_fps=PROJECT.fps);
s23 = SPLIT(input=f22, at=6);
s24 = SPLIT(input=s23.second, at=5);
cc25 = CONCAT(input1=cc20, input2=s24.second);
l26 = LOAD(file="media/vid4.mp4");
f27 = FPS_CHANGE(input=l26, new_fps=PROJECT.fps);
b28 = BLUR(input=f27, sigma=5.58);
l29 = LOAD(file="media/vid3.mp4");
f30 = FPS_CHANGE(input=l29, new_fps=PROJECT.fps);
sat31 = SATURATION_CHANGE(input=f30, factor=2.65);
p32 = PANCAKE(bottom=b28, top=sat31);
sat33 = SATURATION_CHANGE(input=p32, factor=0.59);
tn34 = TRANSITION(a=cc25, b=sat33, kind=CROSSFADE, seconds=10);
p35 = PANCAKE(bottom=p10, top=tn34);
cl36 = COLOR_CHANGE(input=p35, strength=-0.57);

OUTPUT(file="6751135632138520446.mp4", input=cl36);
