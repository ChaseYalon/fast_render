PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid1.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
l2 = LOAD(file="media/vid6.mp4");
f3 = FPS_CHANGE(input=l2, new_fps=PROJECT.fps);
p4 = PANCAKE(bottom=f1, top=f3);
b5 = BLUR(input=p4, sigma=6.13);
t6 = TRIM(input=b5, start=58, end=59);
l7 = LOAD(file="media/vid2.mp4");
f8 = FPS_CHANGE(input=l7, new_fps=PROJECT.fps);
cl9 = COLOR_CHANGE(input=f8, strength=-0.83);
l10 = LOAD(file="media/vid1.mp4");
f11 = FPS_CHANGE(input=l10, new_fps=PROJECT.fps);
b12 = BLUR(input=f11, sigma=0.34);
tn13 = TRANSITION(a=cl9, b=b12, kind=WIPE_LEFT_TO_RIGHT, seconds=12);
cl14 = COLOR_CHANGE(input=tn13, strength=0.75);
p15 = PANCAKE(bottom=t6, top=cl14);
l16 = LOAD(file="media/vid3.mp4");
f17 = FPS_CHANGE(input=l16, new_fps=PROJECT.fps);
cl18 = COLOR_CHANGE(input=f17, strength=-0.43);
tr19 = TRANSFORM(input=cl18, trans_x=394, trans_y=-345, rot_x=417, rot_y=614, deg_of_rot=41.94, scale_x=1915, scale_y=817, scale_factor=2.44);
s20 = SPLIT(input=tr19, at=17);
l21 = LOAD(file="media/vid3.mp4");
f22 = FPS_CHANGE(input=l21, new_fps=PROJECT.fps);
l23 = LOAD(file="media/vid1.mp4");
f24 = FPS_CHANGE(input=l23, new_fps=PROJECT.fps);
l25 = LOAD(file="media/vid2.mp4");
f26 = FPS_CHANGE(input=l25, new_fps=PROJECT.fps);
cc27 = CONCAT(input1=f22, input2=f24, input3=f26);
l28 = LOAD(file="media/vid3.mp4");
f29 = FPS_CHANGE(input=l28, new_fps=PROJECT.fps);
l30 = LOAD(file="media/vid6.mp4");
f31 = FPS_CHANGE(input=l30, new_fps=PROJECT.fps);
tn32 = TRANSITION(a=f29, b=f31, kind=DIP_TO_BLACK, seconds=4);
tn33 = TRANSITION(a=cc27, b=tn32, kind=CROSSFADE, seconds=8);
l34 = LOAD(file="media/vid6.mp4");
f35 = FPS_CHANGE(input=l34, new_fps=PROJECT.fps);
tr36 = TRANSFORM(input=f35, trans_x=-331, trans_y=446, rot_x=1735, rot_y=434, deg_of_rot=-33.13, scale_x=1764, scale_y=1063, scale_factor=0.46);
l37 = LOAD(file="media/vid4.mp4");
f38 = FPS_CHANGE(input=l37, new_fps=PROJECT.fps);
cl39 = COLOR_CHANGE(input=f38, strength=0.15);
l40 = LOAD(file="media/vid4.mp4");
f41 = FPS_CHANGE(input=l40, new_fps=PROJECT.fps);
l42 = LOAD(file="media/vid1.mp4");
f43 = FPS_CHANGE(input=l42, new_fps=PROJECT.fps);
p44 = PANCAKE(bottom=f41, top=f43);
cc45 = CONCAT(input1=tr36, input2=cl39, input3=p44);
cc46 = CONCAT(input1=tn33, input2=cc45);
tn47 = TRANSITION(a=s20.second, b=cc46, kind=WIPE_RIGHT_TO_LEFT, seconds=7);
l48 = LOAD(file="media/vid5.mp4");
f49 = FPS_CHANGE(input=l48, new_fps=PROJECT.fps);
cl50 = COLOR_CHANGE(input=f49, strength=0.37);
cl51 = COLOR_CHANGE(input=cl50, strength=0.84);
s52 = SPLIT(input=cl51, at=3);
tr53 = TRANSFORM(input=s52.first, trans_x=-149, trans_y=222, rot_x=991, rot_y=440, deg_of_rot=-138.97, scale_x=254, scale_y=867, scale_factor=1.95);
cc54 = CONCAT(input1=p15, input2=tn47, input3=tr53);
s55 = SPLIT(input=cc54, at=184);

OUTPUT(file="1051406578415989436.mp4", input=s55.first);
