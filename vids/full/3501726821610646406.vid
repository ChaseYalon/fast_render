PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid5.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
cl2 = COLOR_CHANGE(input=f1, strength=-0.67);
c3 = CROP(input=cl2, left_x=1503, left_y=919, right_x=1517, right_y=974);
c4 = CROP(input=c3, left_x=38, left_y=825, right_x=390, right_y=841);
t5 = TRIM(input=c4, start=1, end=2);
cl6 = COLOR_CHANGE(input=t5, strength=0.24);
l7 = LOAD(file="media/vid5.mp4");
f8 = FPS_CHANGE(input=l7, new_fps=PROJECT.fps);
s9 = SPLIT(input=f8, at=6);
l10 = LOAD(file="media/vid1.mp4");
f11 = FPS_CHANGE(input=l10, new_fps=PROJECT.fps);
t12 = TRIM(input=f11, start=29, end=55);
p13 = PANCAKE(bottom=s9.first, top=t12);
l14 = LOAD(file="media/vid2.mp4");
f15 = FPS_CHANGE(input=l14, new_fps=PROJECT.fps);
tr16 = TRANSFORM(input=f15, trans_x=-158, trans_y=354, rot_x=1485, rot_y=530, deg_of_rot=38.00, scale_x=259, scale_y=191, scale_factor=2.87);
s17 = SPLIT(input=tr16, at=13);
p18 = PANCAKE(bottom=p13, top=s17.first);
cl19 = COLOR_CHANGE(input=p18, strength=-0.14);
tr20 = TRANSFORM(input=cl19, trans_x=-447, trans_y=-488, rot_x=1125, rot_y=536, deg_of_rot=-24.52, scale_x=1550, scale_y=531, scale_factor=1.99);
p21 = PANCAKE(bottom=cl6, top=tr20);

OUTPUT(file="3501726821610646406.mp4", input=p21);
