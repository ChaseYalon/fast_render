PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid6.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
l2 = LOAD(file="media/vid4.mp4");
f3 = FPS_CHANGE(input=l2, new_fps=PROJECT.fps);
l4 = LOAD(file="media/vid3.mp4");
f5 = FPS_CHANGE(input=l4, new_fps=PROJECT.fps);
cc6 = CONCAT(input1=f1, input2=f3, input3=f5);
cl7 = COLOR_CHANGE(input=cc6, strength=0.46);
c8 = CROP(input=cl7, left_x=544, left_y=339, right_x=576, right_y=770);
s9 = SPLIT(input=c8, at=3);
l10 = LOAD(file="media/vid5.mp4");
f11 = FPS_CHANGE(input=l10, new_fps=PROJECT.fps);
tr12 = TRANSFORM(input=f11, trans_x=-448, trans_y=-27, rot_x=22, rot_y=985, deg_of_rot=136.73, scale_x=1595, scale_y=355, scale_factor=1.81);
b13 = BLUR(input=tr12, sigma=1.84);
cl14 = COLOR_CHANGE(input=b13, strength=-0.00);
t15 = TRIM(input=cl14, start=3, end=9);
tn16 = TRANSITION(a=s9.second, b=t15, kind=DIP_TO_BLACK, seconds=2);
l17 = LOAD(file="media/vid6.mp4");
f18 = FPS_CHANGE(input=l17, new_fps=PROJECT.fps);
s19 = SPLIT(input=f18, at=4);
l20 = LOAD(file="media/vid2.mp4");
f21 = FPS_CHANGE(input=l20, new_fps=PROJECT.fps);
l22 = LOAD(file="media/vid1.mp4");
f23 = FPS_CHANGE(input=l22, new_fps=PROJECT.fps);
cc24 = CONCAT(input1=f21, input2=f23);
l25 = LOAD(file="media/vid1.mp4");
f26 = FPS_CHANGE(input=l25, new_fps=PROJECT.fps);
l27 = LOAD(file="media/vid4.mp4");
f28 = FPS_CHANGE(input=l27, new_fps=PROJECT.fps);
p29 = PANCAKE(bottom=f26, top=f28);
cc30 = CONCAT(input1=s19.second, input2=cc24, input3=p29);
sat31 = SATURATION_CHANGE(input=cc30, factor=2.62);
tr32 = TRANSFORM(input=sat31, trans_x=76, trans_y=-247, rot_x=72, rot_y=318, deg_of_rot=-65.36, scale_x=744, scale_y=1054, scale_factor=1.93);
s33 = SPLIT(input=tr32, at=96);
l34 = LOAD(file="media/vid3.mp4");
f35 = FPS_CHANGE(input=l34, new_fps=PROJECT.fps);
tr36 = TRANSFORM(input=f35, trans_x=-331, trans_y=-79, rot_x=514, rot_y=554, deg_of_rot=13.58, scale_x=1587, scale_y=937, scale_factor=2.62);
sat37 = SATURATION_CHANGE(input=tr36, factor=1.24);
cl38 = COLOR_CHANGE(input=sat37, strength=0.12);
cl39 = COLOR_CHANGE(input=cl38, strength=-0.22);
t40 = TRIM(input=cl39, start=5, end=26);
l41 = LOAD(file="media/vid5.mp4");
f42 = FPS_CHANGE(input=l41, new_fps=PROJECT.fps);
tr43 = TRANSFORM(input=f42, trans_x=357, trans_y=18, rot_x=768, rot_y=713, deg_of_rot=79.66, scale_x=1331, scale_y=1014, scale_factor=1.45);
s44 = SPLIT(input=tr43, at=2);
l45 = LOAD(file="media/vid3.mp4");
f46 = FPS_CHANGE(input=l45, new_fps=PROJECT.fps);
b47 = BLUR(input=f46, sigma=3.47);
cl48 = COLOR_CHANGE(input=b47, strength=0.69);
p49 = PANCAKE(bottom=s44.second, top=cl48);
b50 = BLUR(input=p49, sigma=6.37);
l51 = LOAD(file="media/vid3.mp4");
f52 = FPS_CHANGE(input=l51, new_fps=PROJECT.fps);
cl53 = COLOR_CHANGE(input=f52, strength=-0.84);
cl54 = COLOR_CHANGE(input=cl53, strength=-0.80);
l55 = LOAD(file="media/vid5.mp4");
f56 = FPS_CHANGE(input=l55, new_fps=PROJECT.fps);
b57 = BLUR(input=f56, sigma=8.54);
s58 = SPLIT(input=b57, at=2);
p59 = PANCAKE(bottom=cl54, top=s58.second);
c60 = CROP(input=p59, left_x=1447, left_y=381, right_x=1868, right_y=920);
tn61 = TRANSITION(a=b50, b=c60, kind=WIPE_LEFT_TO_RIGHT, seconds=7);
cc62 = CONCAT(input1=tn16, input2=s33.second, input3=t40, input4=tn61);

OUTPUT(file="12018933448428775622.mp4", input=cc62);
