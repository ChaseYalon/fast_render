PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid5.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
sat2 = SATURATION_CHANGE(input=f1, factor=2.61);
cl3 = COLOR_CHANGE(input=sat2, strength=-0.41);
sat4 = SATURATION_CHANGE(input=cl3, factor=1.75);
t5 = TRIM(input=sat4, start=2, end=7);
l6 = LOAD(file="media/vid2.mp4");
f7 = FPS_CHANGE(input=l6, new_fps=PROJECT.fps);
tr8 = TRANSFORM(input=f7, trans_x=204, trans_y=-470, rot_x=1477, rot_y=759, deg_of_rot=110.48, scale_x=743, scale_y=460, scale_factor=0.85);
c9 = CROP(input=tr8, left_x=390, left_y=696, right_x=984, right_y=824);
sat10 = SATURATION_CHANGE(input=c9, factor=0.57);
c11 = CROP(input=sat10, left_x=758, left_y=556, right_x=958, right_y=601);
p12 = PANCAKE(bottom=t5, top=c11);
c13 = CROP(input=p12, left_x=1911, left_y=142, right_x=1915, right_y=931);

OUTPUT(file="15210016608775912851.mp4", input=c13);
