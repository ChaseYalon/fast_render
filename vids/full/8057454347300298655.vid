PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid5.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
sat2 = SATURATION_CHANGE(input=f1, factor=2.74);
b3 = BLUR(input=sat2, sigma=1.99);
l4 = LOAD(file="media/vid6.mp4");
f5 = FPS_CHANGE(input=l4, new_fps=PROJECT.fps);
t6 = TRIM(input=f5, start=2, end=3);
t7 = TRIM(input=t6, start=0, end=1);
p8 = PANCAKE(bottom=b3, top=t7);
l9 = LOAD(file="media/vid6.mp4");
f10 = FPS_CHANGE(input=l9, new_fps=PROJECT.fps);
sat11 = SATURATION_CHANGE(input=f10, factor=2.84);
cl12 = COLOR_CHANGE(input=sat11, strength=0.79);
sat13 = SATURATION_CHANGE(input=cl12, factor=1.32);
p14 = PANCAKE(bottom=p8, top=sat13);
s15 = SPLIT(input=p14, at=4);
sat16 = SATURATION_CHANGE(input=s15.second, factor=0.31);

OUTPUT(file="8057454347300298655.mp4", input=sat16);
