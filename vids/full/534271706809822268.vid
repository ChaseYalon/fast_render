PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid3.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
sat2 = SATURATION_CHANGE(input=f1, factor=0.24);
tr3 = TRANSFORM(input=sat2, trans_x=320, trans_y=290, rot_x=937, rot_y=983, deg_of_rot=131.55, scale_x=640, scale_y=166, scale_factor=1.61);
sat4 = SATURATION_CHANGE(input=tr3, factor=1.80);
tr5 = TRANSFORM(input=sat4, trans_x=151, trans_y=-337, rot_x=1426, rot_y=506, deg_of_rot=84.94, scale_x=422, scale_y=683, scale_factor=2.97);
l6 = LOAD(file="media/vid1.mp4");
f7 = FPS_CHANGE(input=l6, new_fps=PROJECT.fps);
l8 = LOAD(file="media/vid3.mp4");
f9 = FPS_CHANGE(input=l8, new_fps=PROJECT.fps);
p10 = PANCAKE(bottom=f7, top=f9);
cl11 = COLOR_CHANGE(input=p10, strength=0.50);
s12 = SPLIT(input=cl11, at=2);
tr13 = TRANSFORM(input=s12.second, trans_x=-267, trans_y=-289, rot_x=991, rot_y=246, deg_of_rot=-30.56, scale_x=832, scale_y=509, scale_factor=2.33);
l14 = LOAD(file="media/vid2.mp4");
f15 = FPS_CHANGE(input=l14, new_fps=PROJECT.fps);
b16 = BLUR(input=f15, sigma=3.67);
l17 = LOAD(file="media/vid2.mp4");
f18 = FPS_CHANGE(input=l17, new_fps=PROJECT.fps);
sat19 = SATURATION_CHANGE(input=f18, factor=0.90);
tn20 = TRANSITION(a=b16, b=sat19, kind=CROSSFADE, seconds=15);
sat21 = SATURATION_CHANGE(input=tn20, factor=2.10);
b22 = BLUR(input=sat21, sigma=3.34);
cc23 = CONCAT(input1=tr5, input2=tr13, input3=b22);
tr24 = TRANSFORM(input=cc23, trans_x=-229, trans_y=28, rot_x=1798, rot_y=884, deg_of_rot=-41.55, scale_x=227, scale_y=186, scale_factor=0.57);

OUTPUT(file="534271706809822268.mp4", input=tr24);
