PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid1.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
tr2 = TRANSFORM(input=f1, trans_x=-122, trans_y=247, rot_x=1549, rot_y=129, deg_of_rot=-72.44, scale_x=1326, scale_y=836, scale_factor=1.91);
l3 = LOAD(file="media/vid5.mp4");
f4 = FPS_CHANGE(input=l3, new_fps=PROJECT.fps);
b5 = BLUR(input=f4, sigma=6.48);
p6 = PANCAKE(bottom=tr2, top=b5);
s7 = SPLIT(input=p6, at=14);
l8 = LOAD(file="media/vid6.mp4");
f9 = FPS_CHANGE(input=l8, new_fps=PROJECT.fps);
sat10 = SATURATION_CHANGE(input=f9, factor=2.51);
l11 = LOAD(file="media/vid6.mp4");
f12 = FPS_CHANGE(input=l11, new_fps=PROJECT.fps);
tr13 = TRANSFORM(input=f12, trans_x=338, trans_y=-94, rot_x=452, rot_y=14, deg_of_rot=23.27, scale_x=859, scale_y=19, scale_factor=0.76);
cc14 = CONCAT(input1=sat10, input2=tr13);
sat15 = SATURATION_CHANGE(input=cc14, factor=0.25);
tn16 = TRANSITION(a=s7.second, b=sat15, kind=WIPE_LEFT_TO_RIGHT, seconds=10);
tr17 = TRANSFORM(input=tn16, trans_x=61, trans_y=-47, rot_x=1485, rot_y=48, deg_of_rot=-112.02, scale_x=310, scale_y=736, scale_factor=0.53);
l18 = LOAD(file="media/vid6.mp4");
f19 = FPS_CHANGE(input=l18, new_fps=PROJECT.fps);
l20 = LOAD(file="media/vid5.mp4");
f21 = FPS_CHANGE(input=l20, new_fps=PROJECT.fps);
l22 = LOAD(file="media/vid1.mp4");
f23 = FPS_CHANGE(input=l22, new_fps=PROJECT.fps);
cc24 = CONCAT(input1=f19, input2=f21, input3=f23);
l25 = LOAD(file="media/vid1.mp4");
f26 = FPS_CHANGE(input=l25, new_fps=PROJECT.fps);
b27 = BLUR(input=f26, sigma=9.12);
l28 = LOAD(file="media/vid5.mp4");
f29 = FPS_CHANGE(input=l28, new_fps=PROJECT.fps);
l30 = LOAD(file="media/vid3.mp4");
f31 = FPS_CHANGE(input=l30, new_fps=PROJECT.fps);
tn32 = TRANSITION(a=f29, b=f31, kind=WIPE_LEFT_TO_RIGHT, seconds=5);
l33 = LOAD(file="media/vid4.mp4");
f34 = FPS_CHANGE(input=l33, new_fps=PROJECT.fps);
sat35 = SATURATION_CHANGE(input=f34, factor=0.28);
cc36 = CONCAT(input1=cc24, input2=b27, input3=tn32, input4=sat35);
l37 = LOAD(file="media/vid6.mp4");
f38 = FPS_CHANGE(input=l37, new_fps=PROJECT.fps);
b39 = BLUR(input=f38, sigma=2.51);
sat40 = SATURATION_CHANGE(input=b39, factor=2.43);
cc41 = CONCAT(input1=cc36, input2=sat40);
s42 = SPLIT(input=cc41, at=112);
cl43 = COLOR_CHANGE(input=s42.second, strength=-0.42);
cc44 = CONCAT(input1=tr17, input2=cl43);

OUTPUT(file="2572276328326969106.mp4", input=cc44);
