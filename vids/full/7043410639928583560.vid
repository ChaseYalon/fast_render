PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid2.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
cl2 = COLOR_CHANGE(input=f1, strength=0.05);
tr3 = TRANSFORM(input=cl2, trans_x=-308, trans_y=-285, rot_x=935, rot_y=418, deg_of_rot=-136.42, scale_x=694, scale_y=645, scale_factor=1.75);
cl4 = COLOR_CHANGE(input=tr3, strength=0.49);
t5 = TRIM(input=cl4, start=0, end=12);
l6 = LOAD(file="media/vid6.mp4");
f7 = FPS_CHANGE(input=l6, new_fps=PROJECT.fps);
l8 = LOAD(file="media/vid4.mp4");
f9 = FPS_CHANGE(input=l8, new_fps=PROJECT.fps);
p10 = PANCAKE(bottom=f7, top=f9);
cl11 = COLOR_CHANGE(input=p10, strength=-0.08);
b12 = BLUR(input=cl11, sigma=1.06);
cl13 = COLOR_CHANGE(input=b12, strength=-0.63);
l14 = LOAD(file="media/vid6.mp4");
f15 = FPS_CHANGE(input=l14, new_fps=PROJECT.fps);
sat16 = SATURATION_CHANGE(input=f15, factor=2.54);
t17 = TRIM(input=sat16, start=1, end=4);
l18 = LOAD(file="media/vid2.mp4");
f19 = FPS_CHANGE(input=l18, new_fps=PROJECT.fps);
b20 = BLUR(input=f19, sigma=0.35);
l21 = LOAD(file="media/vid6.mp4");
f22 = FPS_CHANGE(input=l21, new_fps=PROJECT.fps);
sat23 = SATURATION_CHANGE(input=f22, factor=1.48);
p24 = PANCAKE(bottom=b20, top=sat23);
p25 = PANCAKE(bottom=t17, top=p24);
c26 = CROP(input=p25, left_x=218, left_y=440, right_x=1007, right_y=596);
cc27 = CONCAT(input1=t5, input2=cl13, input3=c26);
l28 = LOAD(file="media/vid5.mp4");
f29 = FPS_CHANGE(input=l28, new_fps=PROJECT.fps);
t30 = TRIM(input=f29, start=6, end=7);
sat31 = SATURATION_CHANGE(input=t30, factor=2.58);
b32 = BLUR(input=sat31, sigma=0.32);
l33 = LOAD(file="media/vid2.mp4");
f34 = FPS_CHANGE(input=l33, new_fps=PROJECT.fps);
s35 = SPLIT(input=f34, at=11);
l36 = LOAD(file="media/vid3.mp4");
f37 = FPS_CHANGE(input=l36, new_fps=PROJECT.fps);
c38 = CROP(input=f37, left_x=1337, left_y=682, right_x=1906, right_y=909);
p39 = PANCAKE(bottom=s35.second, top=c38);
b40 = BLUR(input=p39, sigma=9.14);
cc41 = CONCAT(input1=b32, input2=b40);
s42 = SPLIT(input=cc41, at=19);
tn43 = TRANSITION(a=cc27, b=s42.second, kind=CROSSFADE, seconds=6);

OUTPUT(file="7043410639928583560.mp4", input=tn43);
