PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid6.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
cl2 = COLOR_CHANGE(input=f1, strength=0.40);
sat3 = SATURATION_CHANGE(input=cl2, factor=0.82);
l4 = LOAD(file="media/vid1.mp4");
f5 = FPS_CHANGE(input=l4, new_fps=PROJECT.fps);
l6 = LOAD(file="media/vid1.mp4");
f7 = FPS_CHANGE(input=l6, new_fps=PROJECT.fps);
p8 = PANCAKE(bottom=f5, top=f7);
cl9 = COLOR_CHANGE(input=p8, strength=0.49);
cc10 = CONCAT(input1=sat3, input2=cl9);
tr11 = TRANSFORM(input=cc10, trans_x=-462, trans_y=43, rot_x=1592, rot_y=510, deg_of_rot=47.45, scale_x=1021, scale_y=680, scale_factor=2.37);
l12 = LOAD(file="media/vid2.mp4");
f13 = FPS_CHANGE(input=l12, new_fps=PROJECT.fps);
tr14 = TRANSFORM(input=f13, trans_x=-374, trans_y=411, rot_x=1524, rot_y=68, deg_of_rot=-4.07, scale_x=1886, scale_y=228, scale_factor=1.54);
l15 = LOAD(file="media/vid4.mp4");
f16 = FPS_CHANGE(input=l15, new_fps=PROJECT.fps);
sat17 = SATURATION_CHANGE(input=f16, factor=2.39);
p18 = PANCAKE(bottom=tr14, top=sat17);
l19 = LOAD(file="media/vid2.mp4");
f20 = FPS_CHANGE(input=l19, new_fps=PROJECT.fps);
s21 = SPLIT(input=f20, at=6);
s22 = SPLIT(input=s21.second, at=8);
p23 = PANCAKE(bottom=p18, top=s22.first);
cl24 = COLOR_CHANGE(input=p23, strength=-0.90);
p25 = PANCAKE(bottom=tr11, top=cl24);
b26 = BLUR(input=p25, sigma=9.57);

OUTPUT(file="11988492721198515930.mp4", input=b26);
