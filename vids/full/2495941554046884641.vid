PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid2.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
cl2 = COLOR_CHANGE(input=f1, strength=-0.66);
c3 = CROP(input=cl2, left_x=1549, left_y=120, right_x=1673, right_y=126);
l4 = LOAD(file="media/vid3.mp4");
f5 = FPS_CHANGE(input=l4, new_fps=PROJECT.fps);
l6 = LOAD(file="media/vid5.mp4");
f7 = FPS_CHANGE(input=l6, new_fps=PROJECT.fps);
p8 = PANCAKE(bottom=f5, top=f7);
cl9 = COLOR_CHANGE(input=p8, strength=0.65);
l10 = LOAD(file="media/vid2.mp4");
f11 = FPS_CHANGE(input=l10, new_fps=PROJECT.fps);
cl12 = COLOR_CHANGE(input=f11, strength=-0.13);
l13 = LOAD(file="media/vid4.mp4");
f14 = FPS_CHANGE(input=l13, new_fps=PROJECT.fps);
tr15 = TRANSFORM(input=f14, trans_x=-166, trans_y=-83, rot_x=1077, rot_y=644, deg_of_rot=33.71, scale_x=1563, scale_y=545, scale_factor=0.25);
p16 = PANCAKE(bottom=cl12, top=tr15);
cc17 = CONCAT(input1=c3, input2=cl9, input3=p16);
l18 = LOAD(file="media/vid2.mp4");
f19 = FPS_CHANGE(input=l18, new_fps=PROJECT.fps);
l20 = LOAD(file="media/vid6.mp4");
f21 = FPS_CHANGE(input=l20, new_fps=PROJECT.fps);
p22 = PANCAKE(bottom=f19, top=f21);
sat23 = SATURATION_CHANGE(input=p22, factor=1.16);
sat24 = SATURATION_CHANGE(input=sat23, factor=0.42);
l25 = LOAD(file="media/vid6.mp4");
f26 = FPS_CHANGE(input=l25, new_fps=PROJECT.fps);
c27 = CROP(input=f26, left_x=610, left_y=803, right_x=1121, right_y=809);
t28 = TRIM(input=c27, start=0, end=2);
sat29 = SATURATION_CHANGE(input=t28, factor=0.76);
cc30 = CONCAT(input1=cc17, input2=sat24, input3=sat29);
b31 = BLUR(input=cc30, sigma=3.04);
l32 = LOAD(file="media/vid5.mp4");
f33 = FPS_CHANGE(input=l32, new_fps=PROJECT.fps);
cl34 = COLOR_CHANGE(input=f33, strength=0.17);
tr35 = TRANSFORM(input=cl34, trans_x=371, trans_y=362, rot_x=1803, rot_y=648, deg_of_rot=-121.83, scale_x=1291, scale_y=688, scale_factor=1.64);
sat36 = SATURATION_CHANGE(input=tr35, factor=2.71);
l37 = LOAD(file="media/vid4.mp4");
f38 = FPS_CHANGE(input=l37, new_fps=PROJECT.fps);
b39 = BLUR(input=f38, sigma=2.18);
c40 = CROP(input=b39, left_x=418, left_y=719, right_x=1459, right_y=972);
s41 = SPLIT(input=c40, at=4);
tn42 = TRANSITION(a=sat36, b=s41.second, kind=WIPE_LEFT_TO_RIGHT, seconds=1);
sat43 = SATURATION_CHANGE(input=tn42, factor=2.23);
p44 = PANCAKE(bottom=b31, top=sat43);

OUTPUT(file="2495941554046884641.mp4", input=p44);
