PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid2.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
cl2 = COLOR_CHANGE(input=f1, strength=-0.34);
sat3 = SATURATION_CHANGE(input=cl2, factor=0.58);
t4 = TRIM(input=sat3, start=7, end=8);
tr5 = TRANSFORM(input=t4, trans_x=-471, trans_y=-20, rot_x=598, rot_y=137, deg_of_rot=-171.87, scale_x=850, scale_y=987, scale_factor=0.51);
l6 = LOAD(file="media/vid3.mp4");
f7 = FPS_CHANGE(input=l6, new_fps=PROJECT.fps);
l8 = LOAD(file="media/vid4.mp4");
f9 = FPS_CHANGE(input=l8, new_fps=PROJECT.fps);
p10 = PANCAKE(bottom=f7, top=f9);
s11 = SPLIT(input=p10, at=8);
l12 = LOAD(file="media/vid2.mp4");
f13 = FPS_CHANGE(input=l12, new_fps=PROJECT.fps);
l14 = LOAD(file="media/vid4.mp4");
f15 = FPS_CHANGE(input=l14, new_fps=PROJECT.fps);
cc16 = CONCAT(input1=f13, input2=f15);
cl17 = COLOR_CHANGE(input=cc16, strength=0.55);
tn18 = TRANSITION(a=s11.first, b=cl17, kind=DIP_TO_BLACK, seconds=1);
l19 = LOAD(file="media/vid3.mp4");
f20 = FPS_CHANGE(input=l19, new_fps=PROJECT.fps);
l21 = LOAD(file="media/vid6.mp4");
f22 = FPS_CHANGE(input=l21, new_fps=PROJECT.fps);
cc23 = CONCAT(input1=f20, input2=f22);
tr24 = TRANSFORM(input=cc23, trans_x=67, trans_y=276, rot_x=1315, rot_y=643, deg_of_rot=33.05, scale_x=1167, scale_y=705, scale_factor=0.39);
sat25 = SATURATION_CHANGE(input=tr24, factor=0.67);
p26 = PANCAKE(bottom=tn18, top=sat25);
tn27 = TRANSITION(a=tr5, b=p26, kind=DIP_TO_BLACK, seconds=1);
t28 = TRIM(input=tn27, start=3, end=10);

OUTPUT(file="16007382703289722774.mp4", input=t28);
