PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid6.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
b2 = BLUR(input=f1, sigma=6.81);
sat3 = SATURATION_CHANGE(input=b2, factor=0.34);
s4 = SPLIT(input=sat3, at=2);
t5 = TRIM(input=s4.first, start=8, end=9);
cl6 = COLOR_CHANGE(input=t5, strength=-0.71);
tr7 = TRANSFORM(input=cl6, trans_x=-368, trans_y=469, rot_x=1126, rot_y=596, deg_of_rot=112.35, scale_x=1605, scale_y=443, scale_factor=0.25);

OUTPUT(file="1461012202763299737.mp4", input=tr7);
