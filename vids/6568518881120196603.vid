PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid1.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
tr2 = TRANSFORM(input=f1, trans_x=-5, trans_y=-447, rot_x=1267, rot_y=310, deg_of_rot=15.81, scale_x=239, scale_y=893, scale_factor=0.34);
sat3 = SATURATION_CHANGE(input=tr2, factor=0.17);
cl4 = COLOR_CHANGE(input=sat3, strength=0.67);
cl5 = COLOR_CHANGE(input=cl4, strength=0.32);
cl6 = COLOR_CHANGE(input=cl5, strength=-0.37);
s7 = SPLIT(input=cl6, at=9);

OUTPUT(file="6568518881120196603.mp4", input=s7.first);
