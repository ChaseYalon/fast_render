PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid3.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
sat2 = SATURATION_CHANGE(input=f1, factor=0.84);
sat3 = SATURATION_CHANGE(input=sat2, factor=2.04);
c4 = CROP(input=sat3, left_x=53, left_y=715, right_x=685, right_y=1038);
b5 = BLUR(input=c4, sigma=4.30);
s6 = SPLIT(input=b5, at=8);
s7 = SPLIT(input=s6.second, at=5);

OUTPUT(file="8482497328859410551.mp4", input=s7.first);
