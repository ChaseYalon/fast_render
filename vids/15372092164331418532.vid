PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid3.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
l2 = LOAD(file="media/vid2.mp4");
f3 = FPS_CHANGE(input=l2, new_fps=PROJECT.fps);
tn4 = TRANSITION(a=f1, b=f3, kind=CROSSFADE, seconds=1);
t5 = TRIM(input=tn4, start=9, end=10);
c6 = CROP(input=t5, left_x=217, left_y=714, right_x=1579, right_y=899);
t7 = TRIM(input=c6, start=8, end=9);
l8 = LOAD(file="media/vid3.mp4");
f9 = FPS_CHANGE(input=l8, new_fps=PROJECT.fps);
sat10 = SATURATION_CHANGE(input=f9, factor=2.25);
c11 = CROP(input=sat10, left_x=871, left_y=444, right_x=1636, right_y=844);
cl12 = COLOR_CHANGE(input=c11, strength=0.38);
cl13 = COLOR_CHANGE(input=cl12, strength=-0.27);
l14 = LOAD(file="media/vid2.mp4");
f15 = FPS_CHANGE(input=l14, new_fps=PROJECT.fps);
l16 = LOAD(file="media/vid5.mp4");
f17 = FPS_CHANGE(input=l16, new_fps=PROJECT.fps);
l18 = LOAD(file="media/vid1.mp4");
f19 = FPS_CHANGE(input=l18, new_fps=PROJECT.fps);
cc20 = CONCAT(input1=f15, input2=f17, input3=f19);
cl21 = COLOR_CHANGE(input=cc20, strength=-0.50);
tr22 = TRANSFORM(input=cl21, trans_x=166, trans_y=-341, rot_x=1074, rot_y=942, deg_of_rot=86.30, scale_x=1063, scale_y=275, scale_factor=2.36);
s23 = SPLIT(input=tr22, at=1);
cc24 = CONCAT(input1=t7, input2=cl13, input3=s23.second);
b25 = BLUR(input=cc24, sigma=0.73);

OUTPUT(file="15372092164331418532.mp4", input=b25);
