PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid6.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
l2 = LOAD(file="media/vid4.mp4");
f3 = FPS_CHANGE(input=l2, new_fps=PROJECT.fps);
p4 = PANCAKE(bottom=f1, top=f3);
l5 = LOAD(file="media/vid1.mp4");
f6 = FPS_CHANGE(input=l5, new_fps=PROJECT.fps);
l7 = LOAD(file="media/vid5.mp4");
f8 = FPS_CHANGE(input=l7, new_fps=PROJECT.fps);
l9 = LOAD(file="media/vid6.mp4");
f10 = FPS_CHANGE(input=l9, new_fps=PROJECT.fps);
cc11 = CONCAT(input1=f6, input2=f8, input3=f10);
p12 = PANCAKE(bottom=p4, top=cc11);
c13 = CROP(input=p12, left_x=33, left_y=274, right_x=1595, right_y=596);
sat14 = SATURATION_CHANGE(input=c13, factor=1.79);
l15 = LOAD(file="media/vid5.mp4");
f16 = FPS_CHANGE(input=l15, new_fps=PROJECT.fps);
t17 = TRIM(input=f16, start=7, end=9);
tr18 = TRANSFORM(input=t17, trans_x=32, trans_y=468, rot_x=396, rot_y=783, deg_of_rot=-112.56, scale_x=299, scale_y=255, scale_factor=2.83);
c19 = CROP(input=tr18, left_x=930, left_y=370, right_x=1279, right_y=491);
l20 = LOAD(file="media/vid6.mp4");
f21 = FPS_CHANGE(input=l20, new_fps=PROJECT.fps);
cl22 = COLOR_CHANGE(input=f21, strength=0.08);
sat23 = SATURATION_CHANGE(input=cl22, factor=1.10);
b24 = BLUR(input=sat23, sigma=7.57);
cc25 = CONCAT(input1=c19, input2=b24);
p26 = PANCAKE(bottom=sat14, top=cc25);
c27 = CROP(input=p26, left_x=1756, left_y=42, right_x=1879, right_y=331);

OUTPUT(file="18371126108896812890.mp4", input=c27);
