PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid5.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
cl2 = COLOR_CHANGE(input=f1, strength=-0.83);
t3 = TRIM(input=cl2, start=1, end=7);
c4 = CROP(input=t3, left_x=1027, left_y=842, right_x=1284, right_y=988);
cl5 = COLOR_CHANGE(input=c4, strength=-0.14);
tr6 = TRANSFORM(input=cl5, trans_x=-234, trans_y=-487, rot_x=598, rot_y=494, deg_of_rot=-67.64, scale_x=702, scale_y=939, scale_factor=0.61);
t7 = TRIM(input=tr6, start=6, end=7);

OUTPUT(file="6994937927939211108.mp4", input=t7);
