PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid6.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
cl2 = COLOR_CHANGE(input=f1, strength=0.47);
cl3 = COLOR_CHANGE(input=cl2, strength=0.36);
cl4 = COLOR_CHANGE(input=cl3, strength=-0.78);
cl5 = COLOR_CHANGE(input=cl4, strength=0.68);
l6 = LOAD(file="media/vid6.mp4");
f7 = FPS_CHANGE(input=l6, new_fps=PROJECT.fps);
b8 = BLUR(input=f7, sigma=3.32);
l9 = LOAD(file="media/vid6.mp4");
f10 = FPS_CHANGE(input=l9, new_fps=PROJECT.fps);
l11 = LOAD(file="media/vid3.mp4");
f12 = FPS_CHANGE(input=l11, new_fps=PROJECT.fps);
cc13 = CONCAT(input1=f10, input2=f12);
l14 = LOAD(file="media/vid6.mp4");
f15 = FPS_CHANGE(input=l14, new_fps=PROJECT.fps);
cl16 = COLOR_CHANGE(input=f15, strength=0.81);
cc17 = CONCAT(input1=b8, input2=cc13, input3=cl16);
tr18 = TRANSFORM(input=cc17, trans_x=437, trans_y=227, rot_x=1689, rot_y=907, deg_of_rot=137.26, scale_x=151, scale_y=249, scale_factor=1.23);
cl19 = COLOR_CHANGE(input=tr18, strength=0.29);
cc20 = CONCAT(input1=cl5, input2=cl19);
l21 = LOAD(file="media/vid3.mp4");
f22 = FPS_CHANGE(input=l21, new_fps=PROJECT.fps);
tr23 = TRANSFORM(input=f22, trans_x=-174, trans_y=-56, rot_x=1464, rot_y=716, deg_of_rot=36.27, scale_x=271, scale_y=609, scale_factor=1.49);
t24 = TRIM(input=tr23, start=7, end=10);
cl25 = COLOR_CHANGE(input=t24, strength=0.16);
s26 = SPLIT(input=cl25, at=7);
sat27 = SATURATION_CHANGE(input=s26.first, factor=0.04);
tn28 = TRANSITION(a=cc20, b=sat27, kind=CROSSFADE, seconds=3);

OUTPUT(file="7943144618643880839.mp4", input=tn28);
