PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid6.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
l2 = LOAD(file="media/vid5.mp4");
f3 = FPS_CHANGE(input=l2, new_fps=PROJECT.fps);
tn4 = TRANSITION(a=f1, b=f3, kind=WIPE_RIGHT_TO_LEFT, seconds=3);
l5 = LOAD(file="media/vid6.mp4");
f6 = FPS_CHANGE(input=l5, new_fps=PROJECT.fps);
s7 = SPLIT(input=f6, at=1);
tn8 = TRANSITION(a=tn4, b=s7.second, kind=CROSSFADE, seconds=3);
s9 = SPLIT(input=tn8, at=8);
l10 = LOAD(file="media/vid1.mp4");
f11 = FPS_CHANGE(input=l10, new_fps=PROJECT.fps);
b12 = BLUR(input=f11, sigma=4.03);
c13 = CROP(input=b12, left_x=963, left_y=46, right_x=1158, right_y=238);
c14 = CROP(input=c13, left_x=801, left_y=420, right_x=1468, right_y=914);
cc15 = CONCAT(input1=s9.second, input2=c14);
sat16 = SATURATION_CHANGE(input=cc15, factor=2.22);
l17 = LOAD(file="media/vid2.mp4");
f18 = FPS_CHANGE(input=l17, new_fps=PROJECT.fps);
t19 = TRIM(input=f18, start=0, end=9);
cl20 = COLOR_CHANGE(input=t19, strength=-0.40);
tr21 = TRANSFORM(input=cl20, trans_x=160, trans_y=-386, rot_x=1342, rot_y=50, deg_of_rot=130.37, scale_x=266, scale_y=323, scale_factor=1.52);
cl22 = COLOR_CHANGE(input=tr21, strength=-0.80);
l23 = LOAD(file="media/vid4.mp4");
f24 = FPS_CHANGE(input=l23, new_fps=PROJECT.fps);
tr25 = TRANSFORM(input=f24, trans_x=-75, trans_y=-166, rot_x=1591, rot_y=333, deg_of_rot=-64.05, scale_x=1750, scale_y=387, scale_factor=1.07);
sat26 = SATURATION_CHANGE(input=tr25, factor=2.01);
l27 = LOAD(file="media/vid2.mp4");
f28 = FPS_CHANGE(input=l27, new_fps=PROJECT.fps);
l29 = LOAD(file="media/vid5.mp4");
f30 = FPS_CHANGE(input=l29, new_fps=PROJECT.fps);
tn31 = TRANSITION(a=f28, b=f30, kind=DIP_TO_BLACK, seconds=3);
s32 = SPLIT(input=tn31, at=2);
p33 = PANCAKE(bottom=sat26, top=s32.first);
l34 = LOAD(file="media/vid1.mp4");
f35 = FPS_CHANGE(input=l34, new_fps=PROJECT.fps);
tr36 = TRANSFORM(input=f35, trans_x=449, trans_y=94, rot_x=965, rot_y=18, deg_of_rot=93.95, scale_x=10, scale_y=947, scale_factor=2.42);
l37 = LOAD(file="media/vid1.mp4");
f38 = FPS_CHANGE(input=l37, new_fps=PROJECT.fps);
tr39 = TRANSFORM(input=f38, trans_x=249, trans_y=228, rot_x=1212, rot_y=447, deg_of_rot=-144.71, scale_x=1869, scale_y=96, scale_factor=0.13);
p40 = PANCAKE(bottom=tr36, top=tr39);
s41 = SPLIT(input=p40, at=6);
p42 = PANCAKE(bottom=p33, top=s41.second);
tn43 = TRANSITION(a=cl22, b=p42, kind=WIPE_RIGHT_TO_LEFT, seconds=1);
p44 = PANCAKE(bottom=sat16, top=tn43);

OUTPUT(file="6719977091165486467.mp4", input=p44);
