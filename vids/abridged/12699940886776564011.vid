PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid3.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
t2 = TRIM(input=f1, start=13, end=22);
sat3 = SATURATION_CHANGE(input=t2, factor=1.71);
cl4 = COLOR_CHANGE(input=sat3, strength=-0.56);
t5 = TRIM(input=cl4, start=6, end=9);
cl6 = COLOR_CHANGE(input=t5, strength=0.47);
t7 = TRIM(input=cl6, start=2, end=3);

OUTPUT(file="12699940886776564011.mp4", input=t7);
