PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid1.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
t2 = TRIM(input=f1, start=9, end=10);
tr3 = TRANSFORM(input=t2, trans_x=118, trans_y=368, rot_x=1537, rot_y=718, deg_of_rot=128.54, scale_x=1262, scale_y=732, scale_factor=1.51);
l4 = LOAD(file="media/vid1.mp4");
f5 = FPS_CHANGE(input=l4, new_fps=PROJECT.fps);
t6 = TRIM(input=f5, start=9, end=10);
t7 = TRIM(input=t6, start=1, end=10);
cc8 = CONCAT(input1=tr3, input2=t7);
cl9 = COLOR_CHANGE(input=cc8, strength=-0.18);
sat10 = SATURATION_CHANGE(input=cl9, factor=2.36);
tr11 = TRANSFORM(input=sat10, trans_x=477, trans_y=-59, rot_x=636, rot_y=713, deg_of_rot=71.90, scale_x=1763, scale_y=911, scale_factor=1.36);

OUTPUT(file="6202437143771537891.mp4", input=tr11);
