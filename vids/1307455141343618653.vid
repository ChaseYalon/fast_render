PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid2.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
b2 = BLUR(input=f1, sigma=1.12);
c3 = CROP(input=b2, left_x=1624, left_y=63, right_x=1832, right_y=242);
l4 = LOAD(file="media/vid6.mp4");
f5 = FPS_CHANGE(input=l4, new_fps=PROJECT.fps);
t6 = TRIM(input=f5, start=7, end=10);
l7 = LOAD(file="media/vid5.mp4");
f8 = FPS_CHANGE(input=l7, new_fps=PROJECT.fps);
cl9 = COLOR_CHANGE(input=f8, strength=-0.93);
tn10 = TRANSITION(a=t6, b=cl9, kind=CROSSFADE, seconds=1);
p11 = PANCAKE(bottom=c3, top=tn10);
tr12 = TRANSFORM(input=p11, trans_x=411, trans_y=-394, rot_x=1441, rot_y=245, deg_of_rot=-97.06, scale_x=1804, scale_y=198, scale_factor=1.16);
l13 = LOAD(file="media/vid2.mp4");
f14 = FPS_CHANGE(input=l13, new_fps=PROJECT.fps);
cl15 = COLOR_CHANGE(input=f14, strength=0.45);
s16 = SPLIT(input=cl15, at=4);
cl17 = COLOR_CHANGE(input=s16.first, strength=-0.68);
s18 = SPLIT(input=cl17, at=3);
tn19 = TRANSITION(a=tr12, b=s18.first, kind=DIP_TO_BLACK, seconds=2);
b20 = BLUR(input=tn19, sigma=2.13);

OUTPUT(file="1307455141343618653.mp4", input=b20);
