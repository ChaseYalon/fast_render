PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid5.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
c2 = CROP(input=f1, left_x=647, left_y=130, right_x=1187, right_y=473);
l3 = LOAD(file="media/vid2.mp4");
f4 = FPS_CHANGE(input=l3, new_fps=PROJECT.fps);
tr5 = TRANSFORM(input=f4, trans_x=-407, trans_y=433, rot_x=455, rot_y=1001, deg_of_rot=-46.91, scale_x=53, scale_y=113, scale_factor=2.18);
p6 = PANCAKE(bottom=c2, top=tr5);
c7 = CROP(input=p6, left_x=10, left_y=931, right_x=825, right_y=945);
cl8 = COLOR_CHANGE(input=c7, strength=0.60);
l9 = LOAD(file="media/vid1.mp4");
f10 = FPS_CHANGE(input=l9, new_fps=PROJECT.fps);
t11 = TRIM(input=f10, start=2, end=7);
l12 = LOAD(file="media/vid5.mp4");
f13 = FPS_CHANGE(input=l12, new_fps=PROJECT.fps);
cl14 = COLOR_CHANGE(input=f13, strength=0.96);
tn15 = TRANSITION(a=t11, b=cl14, kind=DIP_TO_BLACK, seconds=2);
c16 = CROP(input=tn15, left_x=269, left_y=1048, right_x=947, right_y=1061);
c17 = CROP(input=c16, left_x=1755, left_y=379, right_x=1823, right_y=982);
l18 = LOAD(file="media/vid6.mp4");
f19 = FPS_CHANGE(input=l18, new_fps=PROJECT.fps);
c20 = CROP(input=f19, left_x=1259, left_y=726, right_x=1622, right_y=757);
t21 = TRIM(input=c20, start=1, end=3);
c22 = CROP(input=t21, left_x=1767, left_y=330, right_x=1887, right_y=827);
b23 = BLUR(input=c22, sigma=3.73);
cc24 = CONCAT(input1=cl8, input2=c17, input3=b23);
t25 = TRIM(input=cc24, start=6, end=7);

OUTPUT(file="5808649293533611144.mp4", input=t25);
