PROJECT(width=1920, height=1080, fps=30);

l0 = LOAD(file="media/vid4.mp4");
f1 = FPS_CHANGE(input=l0, new_fps=PROJECT.fps);
s2 = SPLIT(input=f1, at=9);
l3 = LOAD(file="media/vid6.mp4");
f4 = FPS_CHANGE(input=l3, new_fps=PROJECT.fps);
s5 = SPLIT(input=f4, at=4);
l6 = LOAD(file="media/vid3.mp4");
f7 = FPS_CHANGE(input=l6, new_fps=PROJECT.fps);
s8 = SPLIT(input=f7, at=1);
l9 = LOAD(file="media/vid2.mp4");
f10 = FPS_CHANGE(input=l9, new_fps=PROJECT.fps);
cl11 = COLOR_CHANGE(input=f10, strength=0.47);
cc12 = CONCAT(input1=s2.first, input2=s5.second, input3=s8.first, input4=cl11);
l13 = LOAD(file="media/vid6.mp4");
f14 = FPS_CHANGE(input=l13, new_fps=PROJECT.fps);
sat15 = SATURATION_CHANGE(input=f14, factor=0.96);
l16 = LOAD(file="media/vid3.mp4");
f17 = FPS_CHANGE(input=l16, new_fps=PROJECT.fps);
s18 = SPLIT(input=f17, at=3);
l19 = LOAD(file="media/vid1.mp4");
f20 = FPS_CHANGE(input=l19, new_fps=PROJECT.fps);
l21 = LOAD(file="media/vid4.mp4");
f22 = FPS_CHANGE(input=l21, new_fps=PROJECT.fps);
l23 = LOAD(file="media/vid1.mp4");
f24 = FPS_CHANGE(input=l23, new_fps=PROJECT.fps);
l25 = LOAD(file="media/vid5.mp4");
f26 = FPS_CHANGE(input=l25, new_fps=PROJECT.fps);
cc27 = CONCAT(input1=f20, input2=f22, input3=f24, input4=f26);
l28 = LOAD(file="media/vid6.mp4");
f29 = FPS_CHANGE(input=l28, new_fps=PROJECT.fps);
l30 = LOAD(file="media/vid4.mp4");
f31 = FPS_CHANGE(input=l30, new_fps=PROJECT.fps);
p32 = PANCAKE(bottom=f29, top=f31);
cc33 = CONCAT(input1=sat15, input2=s18.second, input3=cc27, input4=p32);
tn34 = TRANSITION(a=cc12, b=cc33, kind=WIPE_LEFT_TO_RIGHT, seconds=3);
cl35 = COLOR_CHANGE(input=tn34, strength=-0.65);
tr36 = TRANSFORM(input=cl35, trans_x=74, trans_y=331, rot_x=54, rot_y=1048, deg_of_rot=40.70, scale_x=528, scale_y=579, scale_factor=1.86);
s37 = SPLIT(input=tr36, at=1);

OUTPUT(file="18383207100895390268.mp4", input=s37.second);
